<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Freshline.Api\Freshline.Api.csproj" />
    <!--
      Referenced so the fixture can build its database from the committed migrations and seed it
      through the real DbContext. This is a test-only reference: the API project itself is asserted
      not to reference Entity Framework at all — see ArchitectureTests.
    -->
    <ProjectReference Include="..\..\src\Freshline.Infrastructure\Freshline.Infrastructure.csproj" />
  </ItemGroup>

</Project>