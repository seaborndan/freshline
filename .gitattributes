# Normalise line endings in the repository to LF regardless of the platform a
# contributor is on. Without this, a Windows checkout commits CRLF and every
# subsequent diff on Linux or in CI shows the whole file as changed.
* text=auto eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
