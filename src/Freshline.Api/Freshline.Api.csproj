<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      JWT bearer validation. A dependency addition is a decision under CLAUDE.md, so: what it buys is
      the authentication handler that reads the Authorization header, validates the token and turns
      it into a ClaimsPrincipal. Writing that by hand would mean implementing JWS signature
      verification and claim validation, which is the category of code where a subtle mistake is
      silent and total.

      What it drags in, listed rather than waved at: seven transitive packages, all at 8.19.2 —
      Microsoft.IdentityModel.Abstractions, .JsonWebTokens, .Logging, .Protocols,
      .Protocols.OpenIdConnect, .Tokens and System.IdentityModel.Tokens.Jwt. Checked with
      `dotnet list package` and its include-transitive switch, not assumed. That is a real surface,
      and it is
      accepted because it is the same surface every ASP.NET Core deployment already validates tokens
      with: first-party, versioned with the framework, and covered by the NuGet audit that
      Directory.Build.props promotes to a build error.

      Pinned to the same 10.0.10 band as the rest of the framework packages so a mismatched
      IdentityModel version cannot arrive by way of a floating transitive reference.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Pinned to patch GHSA-v5pm-xwqc-g5wc (stack overflow on circular schema references).
      Microsoft.AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0 transitively;
      2.7.5 is the first patched release in the 2.x line. Remove this pin once the
      ASP.NET Core package ships a reference to a patched version itself.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!--
      A browsable UI over the OpenAPI document. `AddOpenApi` / `MapOpenApi` generate and serve the
      document itself — the JSON contract at /openapi/v1.json — and no user interface at all; the
      .NET templates stopped shipping one when they moved off Swashbuckle. M4's acceptance criterion
      is that a stranger can explore the API, so a UI is a requirement rather than a nicety.

      Chosen over Swashbuckle.AspNetCore.SwaggerUI for one verified reason: on net10.0 this package
      declares no package dependencies at all (checked in its nuspec, not assumed), so it adds a UI
      without adding a supply chain. It is a rendering concern only — it reads the same document
      any other client would.
    -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Infrastructure is referenced so the host can call AddFreshlinePersistence at startup. Nothing
      else in this project may use it: endpoints depend on the interfaces in Core and resolve them
      from the container. ArchitectureTests enforces that by asserting this assembly compiles
      without any reference to Entity Framework — see CLAUDE.md on the shortcut this layout exists
      to prevent.
    -->
    <ProjectReference Include="..\Freshline.Core\Freshline.Core.csproj" />
    <ProjectReference Include="..\Freshline.Infrastructure\Freshline.Infrastructure.csproj" />
  </ItemGroup>

</Project>
