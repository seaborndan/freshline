<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Pinned to patch GHSA-v5pm-xwqc-g5wc (stack overflow on circular schema references).
      Microsoft.AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0 transitively;
      2.7.5 is the first patched release in the 2.x line. Remove this pin once the
      ASP.NET Core package ships a reference to a patched version itself.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Freshline.Core\Freshline.Core.csproj" />
    <ProjectReference Include="..\Freshline.Infrastructure\Freshline.Infrastructure.csproj" />
  </ItemGroup>

</Project>
